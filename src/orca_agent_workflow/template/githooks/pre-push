#!/usr/bin/env sh
# Optional clone-wide protection, including human pushes. Install after bootstrap:
# git config core.hooksPath .githooks
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "Protected branch: push a feature branch and merge through review." >&2
            exit 1
            ;;
    esac
done
